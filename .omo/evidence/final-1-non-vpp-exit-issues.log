    96	func localControlCandidates(ready superHTTPReady) []mtypes.ControlV2Candidate {
    97		candidates := make([]mtypes.ControlV2Candidate, 0, 2)
    98		if ready.v4 != nil && !ready.v4.IsUnspecified() {
    99			candidates = append(candidates, mtypes.ControlV2Candidate{Address: net.JoinHostPort(ready.v4.String(), strconv.Itoa(ready.port)), Source: mtypes.ControlV2CandidateLocal})
   100		}
   101		if ready.v6 != nil && !ready.v6.IsUnspecified() {
   102			candidates = append(candidates, mtypes.ControlV2Candidate{Address: net.JoinHostPort(ready.v6.String(), strconv.Itoa(ready.port)), Source: mtypes.ControlV2CandidateLocal})
   103		}
   104		return candidates
   105	}
   106	
   107	func (runtime *SuperHTTPRuntime) registerRequest(ready superHTTPReady, candidates []mtypes.ControlV2Candidate) mtypes.ControlV2RegisterRequest {
   108		request := mtypes.ControlV2RegisterRequest{
   109			NodeID: runtime.config.NodeID, NodeName: runtime.config.NodeName,
   110			Version: mtypes.ControlV2ProtocolVersion, ListenPort: ready.port, FwMark: ready.fwmark,
   111			DesiredTTL: runtime.config.DefaultTTL, RequestedAt: time.Now(), Implementation: "etherguard",
   112		}
   113		if runtime.device != nil {
   114			runtime.device.staticIdentity.RLock()
   115			request.PubKey = runtime.device.staticIdentity.publicKey.ToString()
   116			runtime.device.staticIdentity.RUnlock()
   117		}
   118		for _, candidate := range candidates {
   119			host, _, err := net.SplitHostPort(candidate.Address)
   120			if err != nil {
   121				continue
   122			}
   123			if net.ParseIP(host).To4() != nil {
   124				request.LocalV4 = append(request.LocalV4, candidate.Address)
   125			} else {
   126				request.LocalV6 = append(request.LocalV6, candidate.Address)
   127			}
   128		}
   129		return request
   130	}
   131	
   132	func (runtime *SuperHTTPRuntime) applySnapshot(snapshot *mtypes.ControlV2Snapshot) {
   133		if snapshot == nil {
   134			return
   135		}
   136		runtime.apply.Lock()
   137		defer runtime.apply.Unlock()
   138		runtime.mu.Lock()
   139		runtime.parameters = snapshot.Parameters
   140		runtime.mu.Unlock()
   141		if runtime.device != nil {
   142			runtime.device.applySuperHTTPSnapshot(snapshot)
   143		}
   144	}
   145	
   146	func (runtime *SuperHTTPRuntime) refreshSTUN(ctx context.Context, parameters mtypes.ControlV2Parameters) {
   147		if runtime.device == nil || runtime.device.superSTUN == nil || len(parameters.STUNServers) == 0 {
   148			return
   149		}
   150		public := runtime.device.superSTUN.Discover(ctx, parameters.STUNServers, parameters.STUNRequestTimeout)
   151		if len(public) == 0 {
   152			return
   153		}
   154		runtime.mu.Lock()
   155		local := append([]mtypes.ControlV2Candidate(nil), runtime.candidates...)
   156		for _, candidate := range local {
   157			if candidate.Source == mtypes.ControlV2CandidateSTUN {
   158				local = local[:0]
   159				break
   160			}
   161		}
   162		runtime.candidates = append(local, public...)
   163		runtime.mu.Unlock()
   164	}
