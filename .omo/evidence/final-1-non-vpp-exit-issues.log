   577	// ---------------------------------------------------------------------------
   578	// Config loading helpers
   579	// ---------------------------------------------------------------------------
   580	
   581	// loadSuperConfigV2 reads a Super YAML file and returns the parsed
   582	// mtypes.SuperConfigV2. It rejects any v1 UDP-only file with a typed
   583	// mtypes.ControlV2ErrLegacyUDPField error before the v2 parser silently
   584	// drops the unknown fields (mtypes.ReadYaml uses yaml.Unmarshal which is
   585	// permissive about unknown keys).
   586	func loadSuperConfigV2(configPath string) (mtypes.SuperConfigV2, error) {
   587		if present, name := legacyUDPFieldPresent(configPath); present {
   588			return mtypes.SuperConfigV2{}, fmt.Errorf("%w: config field %q is no longer accepted in -mode super (HTTP-only); use a v2 SuperConfigV2 YAML", &mtypes.ControlV2Error{Code: mtypes.ControlV2ErrLegacyUDPField}, name)
   589		}
   590	
   591		raw, err := ioutil.ReadFile(configPath)
   592		if err != nil {
   593			return mtypes.SuperConfigV2{}, fmt.Errorf("super: read config %q: %w", configPath, err)
   594		}
   595	
   596		var cfg mtypes.SuperConfigV2
   597		if err := yaml.Unmarshal(raw, &cfg); err != nil {
   598			return mtypes.SuperConfigV2{}, fmt.Errorf("super: parse v2 config %q: %w", configPath, err)
   599		}
   600		if err := cfg.Validate(); err != nil {
   601			return mtypes.SuperConfigV2{}, fmt.Errorf("super: validate v2 config %q: %w", configPath, err)
   602		}
   603		return cfg, nil
   604	}
   605	
   606	// legacyUDPFieldPresent pre-scans a Super YAML file for any of the
   607	// UDP-only field names that mtypes.SuperConfigV2 no longer carries. It
   608	// catches the common mistake of feeding a v1 UDP Super YAML into
   609	// `-mode super` (now HTTP-only) without waiting for the v2 parser's
   610	// silent drop to mis-route the operator. Returns (true, fieldName) on
   611	// the first hit; (false, "") if the file is clean.
   612	func legacyUDPFieldPresent(configPath string) (bool, string) {
   613		raw, err := ioutil.ReadFile(configPath)
   614		if err != nil {
   615			return false, ""
   616		}
   617		for _, name := range []string{"PrivKeyV4", "PrivKeyV6", "ListenPort", "FwMark", "API_Prefix", "ListenPort_EdgeAPI", "ListenPort_ManageAPI"} {
   618			// Match top-level key (`^name:`) only — same-shape keys nested
   619			// under v2 SuperNodeV2 etc. are legitimate.
   620			if bytes.HasPrefix(raw, []byte(name+":")) ||
   621				bytes.Contains(raw, []byte("\n"+name+":")) {
   622				return true, name
   623			}
   624		}
   625		return false, ""
   626	}
