$ GIT_MASTER=1 git show refs/heads/master:main_super.go | nl -ba | sed -n 426,477p
   426	// Shutdown performs the documented graceful shutdown sequence:
   427	//
   428	//  1. Cancel the timeout/recalc ticker.
   429	//  2. Cancel every SSE subscriber via hub.Close() so in-flight event
   430	//     streams return promptly (the SSE renderer's pump goroutine exits
   431	//     when its subscriber's Done channel closes).
   432	//  3. Call http.Server.Shutdown(ctx) on the edge and manage servers so
   433	//     pending non-SSE requests complete before the listeners close.
   434	//  4. If Shutdown(ctx) returns DeadlineExceeded because a long-lived SSE
   435	//     handler is still blocked on r.Context().Done(), force-close the
   436	//     listener via Server.Close() so the handler's blocked channel fires.
   437	//  5. Close the listeners we own (production only).
   438	//
   439	// The SSE graceful-cancellation ordering (hub.Close runs BEFORE
   440	// http.Server.Shutdown) is the documented contract: SSE subscribers must
   441	// observe the hub's Done channel before any HTTP-level shutdown error
   442	// reaches the caller.
   443	//
   444	// Shutdown is safe to call multiple times; only the first call performs
   445	// any work.
   446	func (r *superRuntime) Shutdown(ctx context.Context) error {
   447		r.shutdownOnce.Do(func() {
   448			// 1. Stop the ticker.
   449			if r.tickerCancel != nil {
   450				r.tickerCancel()
   451				select {
   452				case <-r.tickerDone:
   453				case <-time.After(2 * time.Second):
   454				}
   455			}
   456	
   457			// 2. Cancel SSE subscribers BEFORE Shutdown so the renderer's
   458			//    pump goroutine exits when sub.Done() closes.
   459			if r.hub != nil {
   460				r.hub.Close()
   461			}
   462	
   463			// 3. Graceful HTTP shutdown. Each server blocks until in-flight
   464			//    requests return or ctx expires.
   465			var firstErr error
   466			if r.edgeSrv != nil {
   467				if err := r.edgeSrv.Shutdown(ctx); err != nil && !errors.Is(err, http.ErrServerClosed) {
   468					firstErr = fmt.Errorf("super: edge shutdown: %w", err)
   469				}
   470			}
   471			if r.manageSrv != nil && r.manageSrv != r.edgeSrv {
   472				if err := r.manageSrv.Shutdown(ctx); err != nil && !errors.Is(err, http.ErrServerClosed) {
   473					if firstErr == nil {
   474						firstErr = fmt.Errorf("super: manage shutdown: %w", err)
   475					}
   476				}
   477			}
