```go
// Construction
type ManageV2Config struct {
    State        *ControlState
    ConfigDir    string
    BaseConfig   mtypes.SuperConfigV2           // must pass Validate
    EdgeTemplate mtypes.EdgeConfigV2            // placeholders filled by service
    PSKGen       func() string                  // defaults to device.RandomPSK().ToString
}
func NewManageV2(ManageV2Config) (*ManageV2, error)

// Sentinel errors (callers map via mtypes.IsControlV2Error + mtypes.ErrorCode)
var ErrManageDuplicateNodeID   error
var ErrManageDuplicateNodeName error
